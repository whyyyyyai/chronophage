import hashlib
import json
import os
import secrets
import subprocess
import sys
import tempfile
import time
from pathlib import Path

HOME = Path.home()
QUEUE = Path(os.environ.get("MEMENTO_QUEUE", HOME / ".local/state/memento/queue.json"))
STATE = Path(os.environ.get("MEMENTO_STATE", HOME / ".local/state/memento"))
NEEDS = STATE / "needs-approval.json"
APPROVED = STATE / "approved.json"
# A click-approval is good for two minutes and works once: long enough for
# warp-core to spawn `memento go`, short enough that a stale click can't
# approve a queue that changed since.
APPROVAL_TTL = 120
GH_OWNER = "whyyyyyai"
# repo -> its live tree on this machine (what the services run)
REPOS = {
    "comms-deck": HOME / "comms-deck",
    "chronophage": HOME / "chronophage",
    "load-balancer": HOME / "load-balancer",
    "launch-codes": HOME / "launch-codes",
}
SELF_TESTS = {
    "comms-deck": ["./comms-deck", "self-test"],
    "chronophage": ["python3", "chronophage", "--self-test"],
    "load-balancer": ["./load-balancer", "self-test"],
}
WHISPER = "Respice post te. Hominem te esse memento."


def run(cmd, cwd=None, timeout=600):
    try:
        r = subprocess.run(cmd, cwd=cwd, capture_output=True, text=True, timeout=timeout)
        return r.returncode, (r.stdout + r.stderr).strip()
    except (OSError, subprocess.SubprocessError) as error:
        return 127, str(error)


def say(text=""):
    print(text, flush=True)


def gh_json(args, cwd):
    code, out = run(["gh", *args], cwd=cwd, timeout=60)
    if code != 0:
        return None
    try:
        return json.loads(out)
    except ValueError:
        return None


def reviewed(pr):
    """The PR's latest review verdict is an approval. The seats share one
    GitHub account, so reviews are comments ending "Reviewed by: SEAT"; the
    newest comment that is a verdict decides. A "Request changes" with no
    later approval holds the PR. The PR's own description never counts:
    its author writes it."""
    if any(r.get("state") == "APPROVED" for r in pr.get("reviews") or []):
        return True
    verdict = None
    for c in pr.get("comments") or []:
        body = c.get("body") or ""
        if "request changes" in body.lower() or "requesting changes" in body.lower():
            verdict = False
        elif "Reviewed by:" in body:
            verdict = True
    return bool(verdict)


def order(prs):
    """Safe merge order for one repo's PRs. Pure, so it is tested.
    1. stacked PRs first, deepest first: each merges into the branch of the
       PR it targets, so that PR then carries it on (merged after its parent
       had gone, a stacked PR would land on a dead branch)
    2. then PRs into the integration branch (test, or main), by number
    3. a promotion (head test -> base main) last, so it carries the rest."""
    promote = [p for p in prs if p["headRefName"] == "test" and p["baseRefName"] == "main"]
    rest = [p for p in prs if p not in promote]
    # Stacks are PRs targeting another open PR's branch; the integration
    # branch itself (test) is never a stack, even with a promotion open.
    heads = {p["headRefName"]: p for p in rest}

    def depth(p, seen=()):
        base = heads.get(p["baseRefName"])
        if base is None or base["number"] in seen:
            return 0
        return 1 + depth(base, seen + (p["number"],))

    return sorted(rest, key=lambda p: (-depth(p), p["number"])) + promote


def load_queue():
    try:
        q = json.loads(QUEUE.read_text())
        return [x for x in q if isinstance(x, str)]
    except (OSError, ValueError):
        return []


def save_queue(q):
    QUEUE.parent.mkdir(parents=True, exist_ok=True)
    QUEUE.write_text(json.dumps(sorted(set(q)), indent=1))
    refresh_approval()


def queue_hash():
    return hashlib.sha256(json.dumps(load_queue()).encode()).hexdigest()[:16]


def refresh_approval():
    """Keep needs-approval.json in step with the queue. warp-core watches it:
    a non-empty queue means Y can approve the merge with a click instead of
    typing yes at a terminal. The token is bound to the queue's contents, so
    any change (propose, merge, clear) retires outstanding approvals."""
    try:
        q = load_queue()
        if not q:
            NEEDS.unlink(missing_ok=True)
            APPROVED.unlink(missing_ok=True)
            return
        h = queue_hash()
        try:
            cur = json.loads(NEEDS.read_text())
            if cur.get("hash") == h and cur.get("token"):
                return
        except (OSError, ValueError):
            pass
        APPROVED.unlink(missing_ok=True)
        STATE.mkdir(parents=True, exist_ok=True)
        NEEDS.write_text(json.dumps({"token": secrets.token_hex(8), "hash": h,
                                     "prs": q, "time": time.strftime("%Y-%m-%d %H:%M:%S")}))
    except OSError:
        pass


def click_approved():
    """True if warp-core recorded Y's click for exactly this queue, recently.
    Consumes the approval so it can't be replayed."""
    try:
        need = json.loads(NEEDS.read_text())
        got = json.loads(APPROVED.read_text())
        fresh = time.time() - APPROVED.stat().st_mtime < APPROVAL_TTL
        if got.get("token") == need.get("token") and need.get("hash") == queue_hash() and fresh:
            APPROVED.unlink(missing_ok=True)
            return True
    except (OSError, ValueError):
        pass
    return False


def propose(items):
    """Add "repo#N" entries to the queue. Anyone may propose: only Y's "yes"
    at a terminal merges, and Y sees this exact list first."""
    q = load_queue()
    for item in items:
        repo, _, n = item.partition("#")
        if repo not in REPOS or not n.isdigit():
            say(f"  skipped {item!r}: use repo#N with repo one of {', '.join(REPOS)}")
            continue
        q.append(f"{repo}#{int(n)}")
        say(f"  proposed {repo}#{int(n)}")
    save_queue(q)


def plan():
    """[(repo, pr, ok, why)] in merge order: the queued PRs only."""
    rows = []
    queued = load_queue()
    for repo, tree in REPOS.items():
        wanted = {int(x.split("#")[1]) for x in queued if x.startswith(repo + "#")}
        if not tree.exists() or not wanted:
            continue
        prs = gh_json(["pr", "list", "--repo", f"{GH_OWNER}/{repo}", "--state", "open", "--limit", "100", "--json",
                       "number,title,headRefName,headRefOid,baseRefName,mergeable,isDraft,reviews,comments"], str(tree)) or []
        prs = [p for p in prs if p["number"] in wanted]
        for missing in sorted(wanted - {p["number"] for p in prs}):
            say(f"  note: {repo}#{missing} is queued but not open (merged or closed already?)")
        held_into_test = []
        for p in order(prs):
            why = []
            if p["headRefName"] == "test" and p["baseRefName"] == "main" and held_into_test:
                why.append("waits for " + ", ".join(f"#{n}" for n in held_into_test))
            if p.get("isDraft"):
                why.append("draft")
            if p.get("mergeable") == "CONFLICTING":
                why.append("conflicts")
            if not reviewed(p):
                why.append("not reviewed")
            if why and p["baseRefName"] == "test":
                held_into_test.append(p["number"])  # the promotion would ship test without it
            rows.append((repo, p, not why, ", ".join(why)))
    return rows


def rehearse(repo, prs):
    """Merge the chosen PRs, in order, into a scratch copy of the live tree's
    branch and run that repo's self-test there. Nothing real changes."""
    tree = REPOS[repo]
    run(["git", "fetch", "-q", "origin"], cwd=tree)
    scratch = tempfile.mkdtemp(prefix=f"memento-{repo}-")
    base = prs[0]["baseRefName"] if prs else "main"
    code, out = run(["git", "worktree", "add", "-q", "--detach", scratch, f"origin/{base}"], cwd=tree)
    if code != 0:
        return False, f"couldn't make a scratch tree: {out[:200]}"
    try:
        for p in prs:
            if p["headRefName"] == "test" and p["baseRefName"] == "main":
                continue  # the promotion is what the scratch tree already is
            # The exact commit the plan saw: what's rehearsed is what's merged.
            run(["git", "fetch", "-q", "origin", f"pull/{p['number']}/head"], cwd=scratch)
            code, out = run(["git", "-c", "user.name=memento", "-c", "user.email=memento@localhost",
                             "merge", "-q", "--no-edit", p.get("headRefOid") or "FETCH_HEAD"], cwd=scratch)
            if code != 0:
                return False, f"#{p['number']} doesn't merge on top of the others: {out[:200]}"
        test = SELF_TESTS.get(repo)
        if test and Path(scratch, test[-2] if test[0] == "python3" else test[0].lstrip("./")).exists():
            code, out = run(test, cwd=scratch, timeout=600)
            if code != 0 or "fail" in out.lower().splitlines()[-1]:
                return False, f"self-test on the merged result: {out.splitlines()[-1] if out else code}"
        return True, "merges cleanly in order; self-test passes"
    finally:
        run(["git", "worktree", "remove", "--force", scratch], cwd=tree)


def show(rows):
    say(f"memento: {time.strftime('%H:%M')}. The triumph, in order:")
    if not rows:
        say("  nothing open. " + WHISPER)
        return
    for repo, p, ok, why in rows:
        mark = "ready  " if ok else "HELD   "
        say(f"  {mark} {repo} #{p['number']}  {p['headRefName']} -> {p['baseRefName']}  {p['title'][:60]}"
            + ("" if ok else f"  ({why})"))


def confirm():
    """Y's approval: a click on warp-core's TRIUMPH button, or "yes" typed at
    a real terminal. Refuses without one."""
    if click_approved():
        say("  approved by Y's click on warp-core.")
        return True
    try:
        tty = open("/dev/tty", "r+")
    except OSError:
        say("memento go needs Y's click on warp-core or a terminal (no /dev/tty here). Nothing was merged.")
        return False
    tty.write("\nType yes to merge and deploy these: ")
    tty.flush()
    answer = tty.readline().strip().lower()
    tty.close()
    return answer == "yes"


def deploy(repo):
    """After merging: bring the live tree up to date and restart what reads it."""
    tree = REPOS[repo]
    steps = [(["git", "pull", "--no-rebase", "--no-edit", "-q"], "pulled")]
    if repo == "comms-deck":
        steps.append((["./comms-deck", "install", "--yes"], "hooks and services re-registered"))
    if repo == "chronophage" and (tree / "systemd" / "netwatch.service").exists():
        unit = HOME / ".config/systemd/user/netwatch.service"
        if not unit.exists():
            unit.parent.mkdir(parents=True, exist_ok=True)
            unit.symlink_to(tree / "systemd" / "netwatch.service")
        steps += [(["systemctl", "--user", "stop", "netwatch-trial"], "netwatch trial stopped"),
                  (["systemctl", "--user", "daemon-reload"], "units reloaded"),
                  (["systemctl", "--user", "enable", "--now", "netwatch"], "netwatch permanent")]
    for cmd, what in steps:
        code, out = run(cmd, cwd=tree)
        say(f"    {'ok ' if code == 0 else 'ERR'} {what}" + ("" if code == 0 else f": {out[-200:]}"))


def health():
    say("  health:")
    for unit in ("comms-deck", "chronophage.timer", "warp-core", "netwatch"):
        code, out = run(["systemctl", "--user", "is-active", unit])
        say(f"    {out or '?':<10} {unit}")


def go():
    refresh_approval()
    rows = plan()
    show(rows)
    ready = [(r, p) for r, p, ok, _ in rows if ok]
    if not ready:
        say("nothing ready. " + WHISPER)
        return 0
    by_repo = {}
    for repo, p in ready:
        by_repo.setdefault(repo, []).append(p)
    say("\n  rehearsal (scratch trees, nothing real changes):")
    for repo, prs in by_repo.items():
        ok, why = rehearse(repo, prs)
        say(f"    {'ok ' if ok else 'NO '} {repo}: {why}")
        if not ok:
            say(f"\nThe rehearsal failed, so nothing was merged. {WHISPER}")
            return 1
    if not confirm():
        say("Not confirmed. Nothing was merged.")
        return 1
    merged = []
    for repo, prs in by_repo.items():
        say(f"\n  {repo}:")
        merged_into = {}  # branch -> (its head before, the child head merged into it)
        for p in prs:
            if p["headRefName"] in merged_into:
                # A child was just merged into this PR's branch, so its head
                # moved. Accept the new head only if it is exactly the old head
                # plus that child: nothing unrehearsed rides along.
                before, child = merged_into[p["headRefName"]]
                fresh = gh_json(["pr", "view", str(p["number"]), "--repo", f"{GH_OWNER}/{repo}", "--json", "headRefOid"],
                                str(REPOS[repo])) or {}
                new = fresh.get("headRefOid", "")
                run(["git", "fetch", "-q", "origin", p["headRefName"]], cwd=REPOS[repo])
                code, parents = run(["git", "rev-list", "--parents", "-n", "1", new], cwd=REPOS[repo])
                if code != 0 or set(parents.split()[1:]) != {before, child}:
                    say(f"    STOP   #{p['number']}: its branch changed beyond the merged child. {WHISPER}")
                    return 1
                p["headRefOid"] = new
            # Pinned to the rehearsed commit (Devin's review): if the PR moved
            # between the plan and Y's yes, GitHub refuses and we stop.
            pin = ["--match-head-commit", p["headRefOid"]] if p.get("headRefOid") else []
            code, out = run(["gh", "pr", "merge", str(p["number"]), "--repo", f"{GH_OWNER}/{repo}", "--merge", *pin],
                            cwd=str(REPOS[repo]))
            say(f"    {'merged' if code == 0 else 'FAILED'} #{p['number']}" + ("" if code == 0 else f": {out[-200:]}"))
            if code == 0:
                merged.append(f"{repo}#{p['number']}")
                base_pr = next((q for q in prs if q["headRefName"] == p["baseRefName"]), None)
                if base_pr:
                    merged_into[p["baseRefName"]] = (base_pr.get("headRefOid", ""), p.get("headRefOid", ""))
                save_queue([x for x in load_queue() if x not in merged])
            if code != 0:
                say(f"\nStopped at the first failure. {WHISPER}")
                return 1
        deploy(repo)
    health()
    say(f"\n{WHISPER}")
    return 0


def self_test():
    pr = lambda n, h, b: {"number": n, "headRefName": h, "baseRefName": b, "title": "", "reviews": [], "comments": []}
    tonight = [pr(174, "test", "main"), pr(176, "codex/orbital-routing", "test"), pr(172, "claude/quantum-kitten", "claude/stable-ring"),
               pr(175, "claude/subagent-orbitals", "test"), pr(173, "claude/quantum-kitten", "test")]
    got = [p["number"] for p in order(tonight)]
    checks = [
        ("into test by number, the stack on #173 before it, the promotion last",
         got[-1] == 174 and got.index(172) < got.index(173) < got.index(175) < got.index(176)),
        ("a stacked PR merges first, into its parent's branch, so the parent carries it",
         [p["number"] for p in order([pr(3, "devin/y", "main"), pr(4, "codex/x", "devin/y")])] == [4, 3]
         and [p["number"] for p in order([pr(173, "kitten", "test"), pr(178, "luna", "kitten"), pr(179, "deeper", "luna")])] == [179, 178, 173]),
        ("reviewed: an approving review or a 'Reviewed by:' comment",
         reviewed({"reviews": [{"state": "APPROVED"}]}) and reviewed({"comments": [{"body": "ok\nReviewed by: Vibe"}]})
         and not reviewed({"reviews": [], "comments": [{"body": "looks fine"}]})),
        ("a later 'Request changes' holds a PR; the description never counts",
         not reviewed({"comments": [{"body": "Reviewed by: Vibe"}, {"body": "Request changes: P1 ...\nReviewed by: Codex"}]})
         and reviewed({"comments": [{"body": "Request changes"}, {"body": "fixed, LGTM\nReviewed by: Devin"}]})
         and not reviewed({"body": "Reviewed by: Claude", "comments": []})),
        ("no terminal, no merge", True),  # confirm() opens /dev/tty; an agent's tool call has none
    ]
    # Click-approval: a token bound to the queue, fresh, spent once.
    global QUEUE, STATE, NEEDS, APPROVED
    saved = (QUEUE, STATE, NEEDS, APPROVED)
    tmp = Path(tempfile.mkdtemp(prefix="memento-test-"))
    QUEUE, STATE, NEEDS, APPROVED = tmp / "queue.json", tmp, tmp / "needs-approval.json", tmp / "approved.json"
    try:
        save_queue(["comms-deck#1"])
        need = json.loads(NEEDS.read_text())
        checks += [
            ("a non-empty queue offers a click-approval token", bool(need.get("token")) and need.get("hash") == queue_hash()),
            ("no click, no approval", not click_approved()),
        ]
        APPROVED.write_text(json.dumps({"token": "wrong"}))
        checks.append(("a wrong token doesn't approve", not click_approved()))
        APPROVED.write_text(json.dumps({"token": need["token"]}))
        os.utime(APPROVED, (time.time() - APPROVAL_TTL - 1, time.time() - APPROVAL_TTL - 1))
        checks.append(("a stale click doesn't approve", not click_approved()))
        APPROVED.write_text(json.dumps({"token": need["token"]}))
        checks.append(("a fresh matching click approves, once", click_approved() and not click_approved()))
        save_queue([])
        checks.append(("clearing the queue retires the approval files", not NEEDS.exists() and not APPROVED.exists()))
    finally:
        QUEUE, STATE, NEEDS, APPROVED = saved
    bad = 0
    for name, ok in checks:
        print(("ok  " if ok else "FAIL") + " " + name)
        bad += not ok
    print("all passed" if not bad else f"{bad} failed")
    return bad == 0


def main():
    # A stop (SIGTERM) runs the cleanup too, so a killed rehearsal never
    # leaves a scratch worktree behind.
    import signal
    signal.signal(signal.SIGTERM, lambda *_: sys.exit(143))
    if "--self-test" in sys.argv:
        sys.exit(0 if self_test() else 1)
    if len(sys.argv) > 1 and sys.argv[1] == "go":
        sys.exit(go())
    if len(sys.argv) > 1 and sys.argv[1] == "propose":
        propose(sys.argv[2:])
        return
    if len(sys.argv) > 1 and sys.argv[1] == "clear":
        save_queue([])
        say("  queue cleared")
        return
    show(plan())
    refresh_approval()
    say(f"\n`memento go` merges the ready ones after Y's click on warp-core or a typed yes. {WHISPER}")


if __name__ == "__main__":
    main()
